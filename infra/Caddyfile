{
    email admin@{$GTM_ADVISOR_PUBLIC_HOST:gtm-advisor.example}
}

(gtm_advisor_common) {
    encode zstd gzip

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "interest-cohort=()"
        X-Robots-Tag "noindex, nofollow, noarchive"
        -Server
    }

    reverse_proxy gtm_advisor:8011
}

{$GTM_ADVISOR_PUBLIC_HOST:gtm-advisor.example}, www.{$GTM_ADVISOR_PUBLIC_HOST:gtm-advisor.example} {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
        Cross-Origin-Opener-Policy "same-origin"
        Cross-Origin-Resource-Policy "same-origin"
    }
    import gtm_advisor_common
}
